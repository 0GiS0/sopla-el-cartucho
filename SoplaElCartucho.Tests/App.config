<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración para tests de integración.
    Los tests requieren acceso a la base de datos SQL Server.
-->
<configuration>
  <connectionStrings>
    <add name="SoplaElCartuchoDb" 
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SoplaElCartucho;Integrated Security=True" 
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
</configuration>
