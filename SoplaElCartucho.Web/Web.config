<?xml version="1.0" encoding="utf-8"?>
<!--
    🎮 SOPLA EL CARTUCHO - Web.config Legacy
    
    ⚠️ ANTI-PATRONES EN ESTE ARCHIVO:
    1. Configuración XML verbosa (migrar a appsettings.json)
    2. Connection strings en texto plano (usar Azure Key Vault / User Secrets)
    3. Membership Provider obsoleto (migrar a ASP.NET Core Identity)
    4. Session State InProc (usar Redis para escalabilidad)
    5. Custom errors con páginas estáticas (usar middleware de excepciones)
-->
<configuration>
  
  <connectionStrings>
    <!-- ⚠️ ANTI-PATRÓN: Connection string en texto plano -->
    <!-- 📝 MIGRACIÓN: Usar User Secrets en desarrollo, Azure Key Vault en producción -->
    <add name="SoplaElCartuchoDb" 
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SoplaElCartucho;Integrated Security=True" 
         providerName="System.Data.SqlClient"/>
    <add name="SoplaElCartuchoEntities" 
         connectionString="metadata=res://*/Model.csdl|res://*/Model.ssdl|res://*/Model.msl;provider=System.Data.SqlClient;provider connection string=&quot;Data Source=.\SQLEXPRESS;Initial Catalog=SoplaElCartucho;Integrated Security=True;MultipleActiveResultSets=True&quot;" 
         providerName="System.Data.EntityClient"/>
  </connectionStrings>

  <appSettings>
    <!-- ⚠️ LEGACY: Configuración hardcodeada -->
    <add key="NombreTienda" value="Sopla el Cartucho 💨"/>
    <add key="EmailContacto" value="soplaelcartucho@example.com"/>
    <add key="MaxItemsCarrito" value="10"/>
    <add key="IVA" value="21"/>
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8"/>

    <!-- ⚠️ ANTI-PATRÓN: Membership Provider obsoleto desde 2016 -->
    <!-- 📝 MIGRACIÓN: ASP.NET Core Identity con Entity Framework Core -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login" timeout="30" name=".SOPLAELCARTUCHO" protection="All" slidingExpiration="true"/>
    </authentication>

    <membership defaultProvider="SqlMembershipProvider">
      <providers>
        <clear/>
        <add name="SqlMembershipProvider" 
             type="System.Web.Security.SqlMembershipProvider" 
             connectionStringName="SoplaElCartuchoDb"
             enablePasswordRetrieval="false" 
             enablePasswordReset="true" 
             requiresQuestionAndAnswer="false" 
             applicationName="SoplaElCartucho"
             requiresUniqueEmail="true" 
             passwordFormat="Hashed"
             minRequiredPasswordLength="6"
             minRequiredNonalphanumericCharacters="0"/>
      </providers>
    </membership>

    <roleManager enabled="true" defaultProvider="SqlRoleProvider">
      <providers>
        <clear/>
        <add name="SqlRoleProvider" 
             type="System.Web.Security.SqlRoleProvider" 
             connectionStringName="SoplaElCartuchoDb"
             applicationName="SoplaElCartucho"/>
      </providers>
    </roleManager>

    <!-- ⚠️ ANTI-PATRÓN: Session State InProc no escala -->
    <!-- 📝 MIGRACIÓN: Usar Redis o SQL Server para session distribuida -->
    <sessionState mode="InProc" timeout="20" cookieless="false"/>

    <pages>
      <namespaces>
        <add namespace="System.Web.Mvc"/>
        <add namespace="System.Web.Mvc.Ajax"/>
        <add namespace="System.Web.Mvc.Html"/>
        <add namespace="System.Web.Routing"/>
        <add namespace="System.Linq"/>
        <add namespace="System.Collections.Generic"/>
      </namespaces>
    </pages>

    <customErrors mode="RemoteOnly" defaultRedirect="~/Error">
      <error statusCode="404" redirect="~/Error/NotFound"/>
      <error statusCode="500" redirect="~/Error/ServerError"/>
    </customErrors>
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <modules runAllManagedModulesForAllRequests="true"/>
    <handlers>
      <remove name="UrlRoutingHandler"/>
    </handlers>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35"/>
        <bindingRedirect oldVersion="1.0.0.0-5.2.7.0" newVersion="5.2.7.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
