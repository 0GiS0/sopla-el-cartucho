@* 
    🎮 SOPLA EL CARTUCHO - Layout Principal Legacy
    
    ⚠️ ANTI-PATRONES EN ESTE ARCHIVO:
    1. CDN jQuery antigua (1.6.4)
    2. CSS inline y estilos mezclados
    3. Scripts en el head (bloquean render)
    4. Sin bundling/minification
    
    📝 MIGRACIÓN:
    - Usar npm/webpack para gestión de assets
    - Mover scripts al final del body
    - Implementar bundling con ASP.NET Core
*@
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Sopla el Cartucho 🎮</title>
    
    @* ⚠️ LEGACY: Google Fonts inline *@
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">

    @* ⚠️ LEGACY: CSS sin bundling *@
    <link href="@Url.Content("~/Content/css/site.css")" rel="stylesheet" type="text/css" />
    <link href="@Url.Content("~/Content/css/retro.css")" rel="stylesheet" type="text/css" />
    
    @* ⚠️ ANTI-PATRÓN: jQuery muy antigua en el head *@
    <script src="@Url.Content("~/Scripts/jquery-1.6.4.min.js")" type="text/javascript"></script>
    
    @* ⚠️ LEGACY: Estilos inline críticos *@
    <style type="text/css">
        /* Estilos base retro */
        * {
            box-sizing: border-box;
        }
        
        body {
            font-family: 'VT323', monospace;
            background-color: #1a1a2e;
            color: #e0e0e0;
            margin: 0;
            padding: 0;
            font-size: 22px;
            line-height: 1.6;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: 'Press Start 2P', cursive;
            color: #f0d060;
        }
        
        /* Efecto scanlines CRT - sutil para no molestar */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.03),
                rgba(0, 0, 0, 0.03) 1px,
                transparent 1px,
                transparent 3px
            );
            z-index: 9999;
        }
        
        a {
            color: #7eb8da;
            text-decoration: none;
        }
        
        a:hover {
            color: #f0d060;
            text-shadow: 0 0 8px rgba(240, 208, 96, 0.5);
        }
        
        /* Header retro */
        .header {
            background: linear-gradient(180deg, #2d2d44 0%, #1a1a2e 100%);
            border-bottom: 4px solid #f0d060;
            padding: 20px;
            text-align: center;
        }
        
        .header h1 {
            font-size: 24px;
            color: #f0d060;
            text-shadow: 2px 2px 0px #e85d75;
            margin: 0;
        }
        
        .header-logo {
            max-width: 500px;
            height: auto;
            margin-bottom: 10px;
        }
        
        /* Navegación */
        .nav {
            background-color: #252538;
            padding: 12px;
            border-bottom: 2px solid #3d3d5c;
        }
        
        .nav ul {
            list-style: none;
            margin: 0;
            padding: 0;
            text-align: center;
        }
        
        .nav li {
            display: inline-block;
            margin: 0 15px;
        }
        
        .nav a {
            color: #e0e0e0;
            padding: 8px 16px;
            border: 2px solid transparent;
            border-radius: 4px;
            transition: all 0.3s;
        }
        
        .nav a:hover {
            border-color: #f0d060;
            background-color: #3d3d5c;
            color: #f0d060;
        }
        
        /* Carrito badge */
        .carrito-badge {
            background-color: #e85d75;
            color: #ffffff;
            padding: 3px 10px;
            font-size: 14px;
            border-radius: 12px;
            margin-left: 8px;
        }
        
        /* Container principal */
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }
        
        /* Footer retro */
        .footer {
            background-color: #151525;
            border-top: 4px solid #f0d060;
            padding: 20px;
            text-align: center;
            margin-top: 40px;
        }
        
        .footer p {
            font-size: 18px;
            color: #a0a0a0;
        }
        
        /* Mensajes de alerta */
        .alert {
            padding: 15px;
            margin-bottom: 20px;
            border: 2px solid;
            border-radius: 6px;
        }
        
        .alert-success {
            background-color: #1e3a2f;
            border-color: #4ecca3;
            color: #4ecca3;
        }
        
        .alert-error {
            background-color: #3a1e2f;
            border-color: #e85d75;
            color: #e85d75;
        }
        
        /* Botones retro */
        .btn {
            font-family: 'VT323', monospace;
            font-size: 22px;
            padding: 12px 24px;
            border: 3px solid;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.2s;
            text-transform: uppercase;
        }
        
        .btn-primary {
            background-color: #f0d060;
            border-color: #f0d060;
            color: #1a1a2e;
        }
        
        .btn-primary:hover {
            background-color: #f5e080;
            box-shadow: 0 0 15px rgba(240, 208, 96, 0.5);
        }
        
        .btn-danger {
            background-color: #e85d75;
            border-color: #e85d75;
            color: #ffffff;
        }
        
        .btn-danger:hover {
            background-color: #f07088;
            box-shadow: 0 0 15px rgba(232, 93, 117, 0.5);
        }
    </style>
</head>
<body>
    @* ⚠️ LEGACY: Header con logo y navegación *@
    <header class="header">
        <img src="@Url.Content("~/Content/images/sopla-el-cartucho-logo.png")" alt="Sopla el Cartucho" class="header-logo" />
        <p style="font-size: 18px; color: #888; margin-top: 10px;">Tu tienda de videojuegos retro favorita</p>
    </header>
    
    @* ⚠️ ANTI-PATRÓN: Navegación con lógica inline *@
    <nav class="nav">
        <ul>
            <li><a href="@Url.Action("Index", "Home")">🏠 INICIO</a></li>
            <li><a href="@Url.Action("Index", "Catalogo")">🎮 CATÁLOGO</a></li>
            <li>
                <a href="@Url.Action("Index", "Carrito")">
                    🛒 CARRITO
                    @if (Session["CarritoCount"] != null && (int)Session["CarritoCount"] > 0)
                    {
                        <span class="carrito-badge">@Session["CarritoCount"]</span>
                    }
                </a>
            </li>
            @if (Request.IsAuthenticated)
            {
                <li><a href="@Url.Action("Index", "Pedidos")">📦 MIS PEDIDOS</a></li>
                <li><a href="@Url.Action("Profile", "Account")">👤 @User.Identity.Name</a></li>
                <li>
                    @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", style = "display:inline;" }))
                    {
                        @Html.AntiForgeryToken()
                        <a href="javascript:document.getElementById('logoutForm').submit()">🚪 SALIR</a>
                    }
                </li>
            }
            else
            {
                <li><a href="@Url.Action("Login", "Account")">🔑 ENTRAR</a></li>
                <li><a href="@Url.Action("Register", "Account")">📝 REGISTRO</a></li>
            }
        </ul>
    </nav>
    
    <div class="container">
        @* ⚠️ LEGACY: Mensajes con TempData *@
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                ✅ @TempData["Exito"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">
                ❌ @TempData["Error"]
            </div>
        }
        
        @RenderBody()
    </div>
    
    <footer class="footer">
        <p>🎮 SOPLA EL CARTUCHO © @DateTime.Now.Year</p>
        <p style="margin-top: 10px;">
            <a href="@Url.Action("About", "Home")">SOBRE NOSOTROS</a> | 
            <a href="@Url.Action("Contact", "Home")">CONTACTO</a>
        </p>
        <p style="font-size: 16px; margin-top: 15px; color: #444;">
            ⚠️ Aplicación Legacy .NET Framework 4.8 - Solo para demostración
        </p>
    </footer>
    
    @* ⚠️ LEGACY: Scripts al final (pero deberían usar defer/async) *@
    <script src="@Url.Content("~/Scripts/site.js")" type="text/javascript"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
