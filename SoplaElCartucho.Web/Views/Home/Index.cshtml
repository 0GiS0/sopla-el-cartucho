@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="home-container">
    <section class="hero" style="text-align: center; padding: 40px 0; border-bottom: 2px dashed #3d3d5c;">
        <h2 style="font-size: 20px; color: #f0d060;">@ViewBag.Saludo</h2>
        <p style="margin-top: 20px; color: #a0a0a0; font-size: 20px;">
            @ViewBag.Subtitulo
        </p>
        <div style="margin-top: 30px;">
            <a href="@Url.Action("Index", "Catalogo")" class="btn btn-primary">
                ▶ VER CATÁLOGO
            </a>
        </div>
    </section>
    
    <section class="consolas-section" style="margin-top: 40px;">
        <h3 style="color: #f0d060; border-bottom: 2px solid #f0d060; padding-bottom: 10px;">
            🕹️ NUESTRAS CONSOLAS
        </h3>
        
        <table style="width: 100%; margin-top: 20px; border-collapse: separate; border-spacing: 15px;">
            <tr>
                @{
                    var consolas = ViewData["ConsolasDestacadas"] as System.Collections.Generic.List<SoplaElCartucho.Common.Models.Consola>;
                    int count = 0;
                }
                @if (consolas != null)
                {
                    foreach (var consola in consolas)
                    {
                        <td style="background-color: #252538; border: 2px solid #3d3d5c; padding: 20px; text-align: center; width: 16.66%; vertical-align: top; border-radius: 8px;">
                            @if (!string.IsNullOrEmpty(consola.ImagenUrl))
                            {
                                <img src="@consola.ImagenUrl" alt="@consola.Nombre" style="width: 80px; height: 80px; object-fit: contain;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                <div style="font-size: 40px; display: none;">🎮</div>
                            }
                            else
                            {
                                <div style="font-size: 40px;">🎮</div>
                            }
                            <h4 style="color: #f0d060; margin: 10px 0; font-size: 14px;">@consola.Nombre</h4>
                            <p style="font-size: 18px; color: #a0a0a0;">@consola.Fabricante</p>
                            <p style="font-size: 16px; color: #707080;">@consola.AnioLanzamiento</p>
                            <a href="@Url.Action("Index", "Catalogo", new { consolaId = consola.Id })" 
                               style="display: inline-block; margin-top: 10px; font-size: 18px; padding: 8px 14px; border: 2px solid #7eb8da; color: #7eb8da; border-radius: 4px;">
                                VER JUEGOS →
                            </a>
                        </td>
                        count++;
                        if (count % 6 == 0 && count < consolas.Count)
                        {
                            @:</tr><tr>
                        }
                    }
                }
            </tr>
        </table>
    </section>
    
    <section class="juegos-destacados" style="margin-top: 40px;">
        <h3 style="color: #7eb8da; border-bottom: 2px solid #7eb8da; padding-bottom: 10px;">
            ⭐ JUEGOS DESTACADOS
        </h3>
        
        <table style="width: 100%; margin-top: 20px; border-collapse: separate; border-spacing: 15px;">
            <tr>
                @{
                    var juegos = ViewData["JuegosDestacados"] as System.Collections.Generic.List<SoplaElCartucho.Common.Models.Juego>;
                }
                @if (juegos != null)
                {
                    foreach (var juego in juegos)
                    {
                        <td style="background-color: #252538; border: 2px solid #3d3d5c; padding: 20px; text-align: center; width: 25%; vertical-align: top; border-radius: 8px;">
                            @if (!string.IsNullOrEmpty(juego.ImagenUrl))
                            {
                                <img src="@juego.ImagenUrl" alt="@juego.Titulo" style="width: 100px; height: 100px; object-fit: contain;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                <div style="width: 100px; height: 100px; background-color: #1a1a2e; margin: 0 auto; display: none; align-items: center; justify-content: center; font-size: 30px;">🎮</div>
                            }
                            else
                            {
                                <div style="width: 100px; height: 100px; background-color: #1a1a2e; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 30px;">🎮</div>
                            }
                            <h4 style="color: #e0e0e0; margin: 15px 0 5px; font-size: 14px;">@juego.Titulo</h4>
                            <p style="font-size: 18px; color: #a0a0a0;">@juego.Genero</p>
                            <p style="font-size: 22px; color: #4ecca3; margin: 10px 0;">
                                @juego.Precio.ToString("C")
                            </p>
                            <a href="@Url.Action("Detalle", "Catalogo", new { id = juego.Id })" class="btn btn-primary" style="font-size: 18px; padding: 10px 18px;">
                                VER MÁS
                            </a>
                        </td>
                    }
                }
            </tr>
        </table>
    </section>
    
    <section class="caracteristicas" style="margin-top: 50px; padding: 30px 0; border-top: 2px dashed #3d3d5c;">
        <h3 style="color: #e85d75; text-align: center; margin-bottom: 30px;">
            ¿POR QUÉ SOPLA EL CARTUCHO?
        </h3>
        
        <table style="width: 100%; text-align: center;">
            <tr>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">💨</div>
                    <h4 style="color: #f0d060; font-size: 12px; margin: 15px 0;">GARANTIA SOPLO</h4>
                    <p style="font-size: 18px; color: #a0a0a0;">Si no funciona a la primera, sopla y vuelve a intentar!</p>
                </td>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">🎮</div>
                    <h4 style="color: #f0d060; font-size: 12px; margin: 15px 0;">100% ORIGINAL</h4>
                    <p style="font-size: 18px; color: #a0a0a0;">Todos nuestros cartuchos son originales y testeados</p>
                </td>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">📦</div>
                    <h4 style="color: #f0d060; font-size: 12px; margin: 15px 0;">ENVIO RETRO</h4>
                    <p style="font-size: 18px; color: #a0a0a0;">Gratis en pedidos +50 euros (no incluye maquina del tiempo)</p>
                </td>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">🏆</div>
                    <h4 style="color: #f0d060; font-size: 12px; margin: 15px 0;">NOSTALGIA PREMIUM</h4>
                    <p style="font-size: 18px; color: #a0a0a0;">Revive los mejores momentos de tu infancia</p>
                </td>
            </tr>
        </table>
    </section>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            console.log('🎮 ¡Sopla el Cartucho está listo!');
        });
    </script>
}
