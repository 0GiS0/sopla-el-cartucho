@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* 
    🎮 SOPLA EL CARTUCHO - Página de Inicio Legacy
    
    ⚠️ ANTI-PATRONES EN ESTE ARCHIVO:
    1. Uso excesivo de ViewBag/ViewData
    2. Lógica de presentación en la vista
    3. Tablas HTML para layout (no CSS Grid/Flexbox)
    4. Estilos inline
    
    📝 MIGRACIÓN:
    - Crear HomeIndexViewModel fuertemente tipado
    - Usar CSS Grid o Flexbox para layout
    - Mover estilos a archivos CSS
    - Usar componentes parciales para reutilización
*@

<div class="home-container">
    @* ⚠️ LEGACY: Saludo dinámico con ViewBag *@
    <section class="hero" style="text-align: center; padding: 40px 0; border-bottom: 2px dashed #333;">
        <h2 style="font-size: 16px; color: #00ffff;">@ViewBag.Saludo</h2>
        <p style="margin-top: 20px; color: #888;">
            @ViewBag.Subtitulo
        </p>
        <div style="margin-top: 30px;">
            <a href="@Url.Action("Index", "Catalogo")" class="btn btn-primary">
                ▶ VER CATÁLOGO
            </a>
        </div>
    </section>
    
    @* ⚠️ ANTI-PATRÓN: Consolas destacadas con ViewData *@
    <section class="consolas-section" style="margin-top: 40px;">
        <h3 style="color: #ff00ff; border-bottom: 2px solid #ff00ff; padding-bottom: 10px;">
            🕹️ NUESTRAS CONSOLAS
        </h3>
        
        @* ⚠️ LEGACY: Tabla HTML para layout de consolas *@
        <table style="width: 100%; margin-top: 20px; border-collapse: separate; border-spacing: 15px;">
            <tr>
                @{
                    var consolas = ViewData["ConsolasDestacadas"] as System.Collections.Generic.List<SoplaElCartucho.Web.Models.Consola>;
                    int count = 0;
                }
                @if (consolas != null)
                {
                    foreach (var consola in consolas)
                    {
                        <td style="background-color: #111; border: 2px solid #333; padding: 20px; text-align: center; width: 16.66%; vertical-align: top;">
                            @* ⚠️ LEGACY: Imagen de consola con fallback a emoji *@
                            @if (!string.IsNullOrEmpty(consola.ImagenUrl))
                            {
                                <img src="@consola.ImagenUrl" alt="@consola.Nombre" style="width: 80px; height: 80px; object-fit: contain;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                <div style="font-size: 40px; display: none;">🎮</div>
                            }
                            else
                            {
                                <div style="font-size: 40px;">🎮</div>
                            }
                            <h4 style="color: #00ff00; margin: 10px 0; font-size: 10px;">@consola.Nombre</h4>
                            <p style="font-size: 8px; color: #666;">@consola.Fabricante</p>
                            <p style="font-size: 8px; color: #444;">@consola.AnioLanzamiento</p>
                            <a href="@Url.Action("Index", "Catalogo", new { consolaId = consola.Id })" 
                               style="display: inline-block; margin-top: 10px; font-size: 8px; padding: 5px 10px; border: 1px solid #00ff00;">
                                VER JUEGOS →
                            </a>
                        </td>
                        count++;
                        if (count % 6 == 0 && count < consolas.Count)
                        {
                            @:</tr><tr>
                        }
                    }
                }
            </tr>
        </table>
    </section>
    
    @* ⚠️ ANTI-PATRÓN: Juegos destacados con lógica en vista *@
    <section class="juegos-destacados" style="margin-top: 40px;">
        <h3 style="color: #00ffff; border-bottom: 2px solid #00ffff; padding-bottom: 10px;">
            ⭐ JUEGOS DESTACADOS
        </h3>
        
        @* ⚠️ LEGACY: Otra tabla HTML para layout *@
        <table style="width: 100%; margin-top: 20px; border-collapse: separate; border-spacing: 15px;">
            <tr>
                @{
                    var juegos = ViewData["JuegosDestacados"] as System.Collections.Generic.List<SoplaElCartucho.Web.Models.Juego>;
                }
                @if (juegos != null)
                {
                    foreach (var juego in juegos)
                    {
                        <td style="background-color: #111; border: 2px solid #333; padding: 20px; text-align: center; width: 25%; vertical-align: top;">
                            @* ⚠️ LEGACY: Imagen de juego con fallback a emoji *@
                            @if (!string.IsNullOrEmpty(juego.ImagenUrl))
                            {
                                <img src="@juego.ImagenUrl" alt="@juego.Titulo" style="width: 100px; height: 100px; object-fit: contain;" onerror="this.style.display='none';this.nextElementSibling.style.display='block';" />
                                <div style="width: 100px; height: 100px; background-color: #222; margin: 0 auto; display: none; align-items: center; justify-content: center; font-size: 30px;">🎮</div>
                            }
                            else
                            {
                                <div style="width: 100px; height: 100px; background-color: #222; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 30px;">🎮</div>
                            }
                            <h4 style="color: #ffffff; margin: 15px 0 5px; font-size: 10px;">@juego.Titulo</h4>
                            <p style="font-size: 8px; color: #666;">@juego.Genero</p>
                            <p style="font-size: 12px; color: #00ff00; margin: 10px 0;">
                                @juego.Precio.ToString("C")
                            </p>
                            <a href="@Url.Action("Detalle", "Catalogo", new { id = juego.Id })" class="btn btn-primary" style="font-size: 8px; padding: 8px 15px;">
                                VER MÁS
                            </a>
                        </td>
                    }
                }
            </tr>
        </table>
    </section>
    
    @* ⚠️ LEGACY: Sección de características con estilos inline *@
    <section class="caracteristicas" style="margin-top: 50px; padding: 30px 0; border-top: 2px dashed #333;">
        <h3 style="color: #ff00ff; text-align: center; margin-bottom: 30px;">
            ¿POR QUÉ SOPLA EL CARTUCHO?
        </h3>
        
        <table style="width: 100%; text-align: center;">
            <tr>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">💨</div>
                    <h4 style="color: #00ff00; font-size: 10px; margin: 15px 0;">GARANTÍA SOPLO</h4>
                    <p style="font-size: 8px; color: #888;">Si no funciona a la primera, ¡sopla y vuelve a intentar!</p>
                </td>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">🎮</div>
                    <h4 style="color: #00ff00; font-size: 10px; margin: 15px 0;">100% ORIGINAL</h4>
                    <p style="font-size: 8px; color: #888;">Todos nuestros cartuchos son originales y testeados</p>
                </td>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">📦</div>
                    <h4 style="color: #00ff00; font-size: 10px; margin: 15px 0;">ENVÍO RETRO</h4>
                    <p style="font-size: 8px; color: #888;">Gratis en pedidos +50€ (no incluye máquina del tiempo)</p>
                </td>
                <td style="padding: 20px; width: 25%;">
                    <div style="font-size: 40px;">🏆</div>
                    <h4 style="color: #00ff00; font-size: 10px; margin: 15px 0;">NOSTALGIA PREMIUM</h4>
                    <p style="font-size: 8px; color: #888;">Revive los mejores momentos de tu infancia</p>
                </td>
            </tr>
        </table>
    </section>
</div>

@section Scripts {
    <script type="text/javascript">
        // ⚠️ LEGACY: jQuery spaghetti code
        $(document).ready(function() {
            // Efecto de parpadeo en el título
            setInterval(function() {
                $('.hero h2').css('opacity', Math.random() > 0.1 ? 1 : 0.8);
            }, 100);
            
            console.log('🎮 ¡Sopla el Cartucho está listo!');
            console.log('💨 Presiona F12 para ver más easter eggs...');
        });
    </script>
}
