@{
    ViewBag.Title = "Registro";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="register-container" style="max-width: 400px; margin: 50px auto;">
    <h2 style="color: #00ff00; text-align: center; margin-bottom: 30px;">
        📝 CREAR CUENTA
    </h2>
    
    <div style="background-color: #111; border: 2px solid #333; padding: 30px;">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error" style="margin-bottom: 20px;">
                @ViewBag.Error
            </div>
        }
        
        @using (Html.BeginForm("Register", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; display: block; margin-bottom: 8px;">NOMBRE DE USUARIO *</label>
                <input type="text" name="username" required autofocus
                       style="width: 100%; padding: 12px; font-family: 'Press Start 2P'; font-size: 10px; background-color: #222; color: #00ff00; border: 2px solid #333;"
                       placeholder="retro_gamer_86" />
            </div>
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; display: block; margin-bottom: 8px;">EMAIL *</label>
                <input type="email" name="email" required
                       style="width: 100%; padding: 12px; font-family: 'Press Start 2P'; font-size: 10px; background-color: #222; color: #00ff00; border: 2px solid #333;"
                       placeholder="gamer@email.com" />
            </div>
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; display: block; margin-bottom: 8px;">CONTRASEÑA *</label>
                <input type="password" name="password" required minlength="6"
                       style="width: 100%; padding: 12px; font-family: 'Press Start 2P'; font-size: 10px; background-color: #222; color: #00ff00; border: 2px solid #333;"
                       placeholder="Mínimo 6 caracteres" />
            </div>
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; display: block; margin-bottom: 8px;">REPETIR CONTRASEÑA *</label>
                <input type="password" name="confirmPassword" required
                       style="width: 100%; padding: 12px; font-family: 'Press Start 2P'; font-size: 10px; background-color: #222; color: #00ff00; border: 2px solid #333;"
                       placeholder="Repite la contraseña" />
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 15px;">
                ✓ CREAR CUENTA
            </button>
        }
        
        <p style="text-align: center; margin-top: 20px; font-size: 10px; color: #666;">
            ¿Ya tienes cuenta? 
            <a href="@Url.Action("Login", "Account")">Inicia sesión</a>
        </p>
    </div>
</div>
