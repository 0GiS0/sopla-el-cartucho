@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="login-container" style="max-width: 400px; margin: 50px auto;">
    <h2 style="color: #00ff00; text-align: center; margin-bottom: 30px;">
        🔑 INICIAR SESIÓN
    </h2>
    
    <div style="background-color: #111; border: 2px solid #333; padding: 30px;">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-error" style="margin-bottom: 20px;">
                @ViewBag.Error
            </div>
        }
        
        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; display: block; margin-bottom: 8px;">USUARIO</label>
                <input type="text" name="username" required autofocus
                       style="width: 100%; padding: 12px; font-family: 'Press Start 2P'; font-size: 10px; background-color: #222; color: #00ff00; border: 2px solid #333;"
                       placeholder="tu_usuario" />
            </div>
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; display: block; margin-bottom: 8px;">CONTRASEÑA</label>
                <input type="password" name="password" required
                       style="width: 100%; padding: 12px; font-family: 'Press Start 2P'; font-size: 10px; background-color: #222; color: #00ff00; border: 2px solid #333;"
                       placeholder="********" />
            </div>
            
            <div style="margin-bottom: 20px;">
                <label style="color: #666; font-size: 10px; cursor: pointer;">
                    <input type="checkbox" name="rememberMe" value="true" style="margin-right: 8px;" />
                    Recordarme
                </label>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%; padding: 15px;">
                ▶ ENTRAR
            </button>
        }
        
        <p style="text-align: center; margin-top: 20px; font-size: 10px; color: #666;">
            ¿No tienes cuenta? 
            <a href="@Url.Action("Register", "Account")">Regístrate aquí</a>
        </p>
    </div>
</div>
